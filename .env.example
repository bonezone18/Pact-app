# Copy to .env.local and fill in. `npx supabase status` prints the local Supabase values.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Host that serves invite links (https://<host>/j/<code>) and the landing page.
EXPO_PUBLIC_LINK_HOST=lockstep.app

# Google Sign-In: OAuth client IDs from Google Cloud. The web client ID is the
# one Supabase verifies tokens against.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Build-time only: reversed iOS client ID, e.g. com.googleusercontent.apps.1234-abcd
GOOGLE_IOS_URL_SCHEME=
